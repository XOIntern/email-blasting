// use prisma-8

model Email {
  id            Int         @id @default(autoincrement())
  subject       String
  body          String      
  recipients    Recipient[]
}

model Recipient {
  id            Int         @id @default(autoincrement())
  name          String      @unique
  emailAddress  String      @unique

  emailId       Int
  email         Email       @relation(fields: [emailId], references: [id])
}
